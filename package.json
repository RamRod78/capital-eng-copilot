    "@tanstack/react-query": "^5.66.0",
    "@tanstack/react-table": "^8.21.2",
    "clsx": "^2.1.1",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.39.3",
    "hono": "^4.7.1",
    "lucide-react": "^0.475.0",
    "mammoth": "^1.9.0",
    "pdf-parse": "^1.1.1",
    "pg": "^8.13.3",
    "pgvector": "^0.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.54.2",
    "react-router-dom": "^6.29.0",
    "tailwind-merge": "^3.0.1",
